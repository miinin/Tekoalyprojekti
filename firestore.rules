rules_version = '2';

// AI Van! -pelin Firestore-säännöt. Julkaisu: firebase deploy --only firestore:rules
//
// Pelissä ei ole kirjautumista. Opettaja kirjautuu pelin palvelimelle (server/teacherApi.js)
// luokkakoodilla ja PIN-koodilla. Palvelin laskee väärät yritykset ja antaa oikealla PIN-koodilla
// luokan pitkän satunnaisen avaimen (token). Jokaisessa opettajan kirjoituserässä (writeBatch)
// on mukana dokumentin class_sessions/{code}/private/auth kirjoitus, jossa on avain ja
// lastAuthAt = request.time. Sen kirjoitus onnistuu vain oikealla avaimella. Muiden dokumenttien
// säännöt tarkistavat getAfter()-kutsulla, että sama erä sisälsi onnistuneen avainkirjoituksen.
// PIN-koodi on dokumentissa private/secret, jota vain palvelin käsittelee.
service cloud.firestore {
  match /databases/{database}/documents {

    function authPath(code) {
      return /databases/$(database)/documents/class_sessions/$(code)/private/auth;
    }

    // Tosi vain, jos tämä sama erä kirjoitti private/auth-dokumentin (ja se hyväksyttiin).
    function teacherAuthed(code) {
      return getAfter(authPath(code)).data.lastAuthAt == request.time;
    }

    function sessionKeys() {
      return ['status', 'requireTutorial', 'createdAt', 'pausedAt', 'hiddenPlayers'];
    }

    // Palkintokentät ovat tyhjät (puuttuvat tai null).
    function giftsClear(data) {
      return data.get('teacherGift', null) == null && data.get('teacherBoostsGift', null) == null;
    }

    // Luokka on olemassa eikä ole päättynyt.
    function sessionOpen(code) {
      let path = /databases/$(database)/documents/class_sessions/$(code);
      return exists(path) && get(path).data.get('status', 'active') != 'ended';
    }

    // Opettajan avainkirjoitus: avain on sama kuin palvelimen tallentama.
    function tokenWrite() {
      return request.resource.data.keys().hasOnly(['token', 'lastAuthAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && resource.data.get('token', '') == request.resource.data.token
        && request.resource.data.lastAuthAt == request.time;
    }

    match /class_sessions/{code} {
      // Oppilaat lukevat luokan tilan (käsijarru, opastusvaatimus). Listaus estetty.
      allow get: if true;
      allow list: if false;
      // Uudet luokat luo pelin palvelin (server/teacherApi.js).
      allow create: if false;
      allow update: if teacherAuthed(code)
        && request.resource.data.keys().hasOnly(sessionKeys())
        && request.resource.data.status in ['active', 'paused', 'ended'];
      allow delete: if false;

      match /private/auth {
        // Palvelin luo dokumentin. Avaimen voi "kirjoittaa uudelleen" vain samana: tämä on opettajan tarkistus.
        allow read, create, delete: if false;
        allow update: if tokenWrite();
      }
      // private/secret (PIN-koodi ja väärien yritysten laskuri): ei sääntöä, joten selain ei pääse siihen.

      match /players/{nickname} {
        // Opettaja seuraa koko luokkaa, oppilas kuuntelee omaa dokumenttiaan.
        allow read: if true;
        // Oppilas kirjoittaa oman edistymisensä. Palkinnot (teacherGift, teacherBoostsGift)
        // saa asettaa vain opettaja; oppilas saa ainoastaan tyhjentää ne lunastettuaan.
        // Oppilaan voi lisätä vain olemassa olevaan luokkaan, joka ei ole päättynyt.
        allow create: if (giftsClear(request.resource.data) || teacherAuthed(code))
          && nickname.size() <= 40
          && sessionOpen(code);
        allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['teacherGift', 'teacherBoostsGift'])
          || giftsClear(request.resource.data)
          || teacherAuthed(code);
        allow delete: if false;
      }
    }

    // Rekisterikilvellä (esim. ABC-123) tallennetut yksinpelit.
    match /saves/{code} {
      allow get: if true;
      allow list: if false;
      // Tallennuksen voi vain luoda: olemassa olevaa ei voi kirjoittaa yli.
      allow create: if request.resource.data.size() <= 60;
      allow update: if false;
      allow delete: if false;
    }

    // Pelaajien virheilmoitukset. Luku ja poisto vaativat ylläpitoa, jota ei vielä ole.
    match /bug_reports/{id} {
      allow read, delete: if false;
      allow create: if request.resource.data.keys().hasOnly(['questionId', 'text', 'date'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000;
    }
  }
}
